{
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/clinique-frontend/browser",
  "rewrites": [
    { "source": "/((?!sitemap.xml|robots.txt|assets/.*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
